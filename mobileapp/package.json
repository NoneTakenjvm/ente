        "lint": "eslint . --config config/eslint/eslint.config.mjs",
        "lint:fix": "eslint . --fix --config config/eslint/eslint.config.mjs",
        "spike": "tsx --tsconfig scripts/tsconfig.json scripts/m0-spike.ts",
        "cli": "tsx --tsconfig scripts/tsconfig.json scripts/ente-cli.ts",
        "test": "vitest run"
    },
