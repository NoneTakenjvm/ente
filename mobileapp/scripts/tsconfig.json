{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": {
            "@/*": ["../src/*"],
            "ente-base/crypto": ["../src/core/crypto-shim.ts"]
        }
    },
    "include": ["./**/*.ts", "../src/core/**/*.ts"]
}
